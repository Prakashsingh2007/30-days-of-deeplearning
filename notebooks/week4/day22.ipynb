   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "rnn = nn.RNN(\n",
    "    input_size=3,\n",
    "    hidden_size=5,\n",
    "    num_layers=1,\n",
    "    batch_first=True\n",
    ")\n",
    "\n",
    "x = torch.randn(4, 6, 3)\n",
    "\n",
    "output, hidden = rnn(x)\n",
    "\n",
    "print(\"Input shape:\", x.shape)\n",
    "print(\"Output shape:\", output.shape)\n",
    "print(\"Hidden shape:\", hidden.shape)"
   ]
  }
 ],
