   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "\n",
    "model = nn.Sequential(\n",
    "    nn.Linear(5,10),\n",
    "    nn.ReLU(),\n",
    "    nn.Linear(10,6),\n",
    "    nn.ReLU(),\n",
    "    nn.Linear(6,2)\n",
    ")\n",
    "\n",
    "x = torch.randn(32,5)\n",
    "\n",
    "output = model(x)\n",
    "print(model)\n",
    "print(output.shape)\n",
    "print(output)"
   ]
  }
